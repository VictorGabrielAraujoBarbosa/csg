; The plaque leans back off the kerb's top-inner corner (0, 0.185, 0.205), so its
; bottom edge rests on the rail and its face points up at the game camera
; (pitch 50). Careful with the sign: .tscn writes a basis row-major, so the
; middle three numbers are the Y axis — Y must point UP and BACK (-Z).
[node name="Plaque" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.819152, 0.5735765, 0, -0.5735765, 0.819152, 0, 0.226, 0.176)
material_override = SubResource("StandardMaterial3D_plaque")
mesh = SubResource("BoxMesh_plaque")

; Right figure, turned -90 deg around Y: its bowl points at -X, i.e. left, at
; the other mascot. (tscn writes the basis row-major; the scale 0.6 sits on the
; diagonal.)
[node name="MascotRed" parent="." instance=ExtResource("1_red")]
transform = Transform3D(0, 0, -0.6, 0, 0.6, 0, 0.6, 0, 0, 0.4231, 0.06, -0.1138)

; Left figure, turned +90 deg around Y: its bowl points at +X, at the red one.
[node name="MascotYellow" parent="." instance=ExtResource("2_yellow")]
transform = Transform3D(0, 0, 0.6, 0, 0.6, 0, -0.6, 0, 0, -0.4231, 0.06, 0.0738)
